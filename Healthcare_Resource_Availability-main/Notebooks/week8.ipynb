    "# Define evaluation function with try-except\n",
    "def evaluate_lightgbm(model, X_train, y_train, X_val, y_val, model_name):\n",
    "    try:\n",
    "        # Suppress LightGBM's internal output\n",
    "        with contextlib.redirect_stdout(io.StringIO()):\n",
    "            model.fit(X_train, y_train, callbacks=[lgb.log_evaluation(0)])\n",
    "\n",
    "        train_preds = model.predict(X_train)\n",
    "        val_preds = model.predict(X_val)\n",
    "\n",
    "        metrics = {\n",
    "            \"Model\": model_name,\n",
    "            \"Train RMSE\": np.sqrt(mean_squared_error(y_train, train_preds)),\n",
    "            \"Validation RMSE\": np.sqrt(mean_squared_error(y_val, val_preds)),\n",
    "            \"Train R²\": r2_score(y_train, train_preds),\n",
    "            \"Validation R²\": r2_score(y_val, val_preds),\n",
    "        }\n",
    "\n",
    "        print(f\"{model_name} - Train RMSE: {metrics['Train RMSE']:.4f}, Validation RMSE: {metrics['Validation RMSE']:.4f}\")\n",
    "        return metrics\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"Error in {model_name}: {e}\")\n",
    "        return {\n",
    "            \"Model\": model_name,\n",
    "            \"Train RMSE\": None,\n",
    "            \"Validation RMSE\": None,\n",
    "            \"Train R²\": None,\n",
    "            \"Validation R²\": None,\n",
    "        }\n"
   ]
  },
